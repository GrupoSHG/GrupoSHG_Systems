# Copia este archivo a ".env" (sin el .example) y completa tus datos reales.
# El archivo ".env" NUNCA se sube a git (ver .gitignore).

# --- SimpleAPI ---
SIMPLEAPI_KEY=1111-1111-1111-1111
RUT_CERTIFICADO=18076720-7
RUT_EMPRESA=76XXXXXXX-X
PASSWORD_CERT=cambia_esto
AMBIENTE=1
# Ruta al certificado digital .pfx en este servidor (nunca en el navegador)
